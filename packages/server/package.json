{
  "name": "@questra/server",
  "version": "0.1.0",
  "description": "The sync server: Fastify + ws WebSocket wire protocol, join/replay/reconnect, idempotent intents, presence, prompt timeouts. Reuses the contracts visibility filter (no second implementation) and the engine fold/pipeline. Never imports AI directly.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.check.json && vitest run",
    "dev": "tsx src/main.ts",
    "migrate": "node scripts/migrate.mjs",
    "migrate:up": "npm run migrate up",
    "migrate:down": "npm run migrate down",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@questra/contracts": "*",
    "@questra/engine": "*",
    "fastify": "^5.2.0",
    "hash-wasm": "^4.12.0",
    "jose": "^5.9.6",
    "pg": "^8.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@questra/ai": "*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "node-pg-migrate": "^7.9.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
