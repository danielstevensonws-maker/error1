{
  "name": "@questra/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared look-and-feel components. Themed only via @questra/theme's --qa-* tokens; no hardcoded colours, sizes, or fonts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && tsc -p tsconfig.check.json && vitest run",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@questra/theme": "*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
