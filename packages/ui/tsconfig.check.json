{
  /*
   * THE TYPECHECK CONFIG, WHICH IS A SUPERSET OF THE BUILD CONFIG.
   *
   * `tsconfig.json` beside this one is the BUILD: it emits to `dist` with
   * `rootDir: "src"`, so it cannot also cover `test/` — a test file is not
   * under the root dir and has no business in the published output. The
   * result was that `check` ran `tsc` over the source only and the test tree
   * was never typechecked at all.
   *
   * That is not theoretical: the same hole in `packages/server` let a changed
   * function signature through `tsc` clean and fail at RUNTIME instead
   * (2026-08-25). Tests are source; they get the same strictness as
   * everything else. `build` still uses `tsconfig.json`, so `dist` is
   * unchanged.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Nothing is written from here. `rootDir` widens to the package so the
       test tree is a legal input rather than "outside rootDir", and the emit
       flags are off so widening it cannot produce output by accident. */
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    /* The hygiene suite walks the source tree with node:fs, and @types/node is
       installed at the workspace root rather than in this package, so the
       default type-root walk does not pick it up. Naming it here keeps the
       BUILD config free of a dependency only the tests have. */
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"]
}
