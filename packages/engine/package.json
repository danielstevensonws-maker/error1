{
  "name": "@questra/engine",
  "version": "0.1.0",
  "description": "The pure event-sourced engine, sheet computation, and the SRD ingestion pipeline. Depends on @questra/contracts for all shapes; never imports anything AI (ADR-0005).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.check.json && vitest run",
    "ingest": "tsx ingest/run.ts",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@questra/contracts": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.0.0",
    "tsx": "^4.19.0",
    "@types/node": "^24.0.0"
  }
}
